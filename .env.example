# ==============================================================================
# CareTriage AI - Environment Configuration Example
# Copy this file to .env and adjust values for your local setup.
# ==============================================================================

# Server Configuration
PORT=5000

# Conversational LLM Engine Configuration
# Primary: Local Ollama daemon running llama3.1:8b (http://localhost:11434)
# Secondary Fallback: Groq Cloud API (Optional)
# If neither Ollama nor GROQ_API_KEY is available, system automatically uses
# the offline canonical symptom extraction heuristic assistant.
GROQ_API_KEY=

# Kaggle Dataset Path (Optional - only needed to re-run 200-sample evaluations or retraining)
# KAGGLE_DATASET_CSV=/path/to/Final_Augmented_dataset_Diseases_and_Symptoms.csv
